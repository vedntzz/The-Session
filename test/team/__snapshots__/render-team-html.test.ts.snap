// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderTeamHtml > matches snapshot for a typical report 1`] = `
"<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Team Report (2026-10-01 to 2026-10-07)</title><style>:root { --bg: #ffffff; --card: #f6f8fa; --fg: #1f2328; --muted: #656d76; --border: #d0d7de; --font: ui-monospace, SFMono-Regular, Menlo, monospace; }
@media (prefers-color-scheme: dark) { :root { --bg: #0d1117; --card: #161b22; --fg: #e6edf3; --muted: #848d97; --border: #30363d; } }
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 14px; padding: 2rem; }
main { max-width: 64rem; margin: 0 auto; }
h1 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; }
h2 { font-size: 1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
.summary { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; }
.metric { background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 0.75rem 1rem; min-width: 9rem; }
.metric .val { display: block; font-size: 1.1rem; font-weight: 600; }
.metric .lbl { display: block; font-size: 0.75rem; color: var(--muted); margin-top: 0.25rem; }
.empty { padding: 2rem 0; color: var(--muted); }
table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
th { font-weight: 600; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; }
ol { padding-left: 1.5rem; margin-top: 0.5rem; }
li { padding: 0.25rem 0; }</style></head>
<body><main><h1>Team Report (2026-10-01 to 2026-10-07)</h1><div class="summary"><div class="metric"><span class="val">$125.50</span><span class="lbl">Spend</span></div><div class="metric"><span class="val">2 unpriced</span><span class="lbl">Coverage</span></div><div class="metric"><span class="val">50% shipped</span><span class="lbl">Shipped</span></div><div class="metric"><span class="val">10% never-merged</span><span class="lbl">Never Merged</span></div><div class="metric"><span class="val">20% still-open</span><span class="lbl">Still Open</span></div><div class="metric"><span class="val">10% no-changes</span><span class="lbl">No Changes</span></div></div><section class="groups"><h2>Groups</h2><table><thead><tr><th>Repo</th><th>Agent</th><th>Sessions</th><th>Spend</th><th>Unpriced</th><th>Shipped</th></tr></thead><tbody><tr><td>repo-a</td><td>codex</td><td>5</td><td>$105.50</td><td>0</td><td>40%</td></tr><tr><td>repo-b</td><td>claude</td><td>3</td><td>$20.00</td><td>0</td><td>67%</td></tr><tr><td>repo-c</td><td>gemini</td><td>2</td><td>unpriced</td><td>2</td><td>50%</td></tr></tbody></table></section><section class="costliest"><h2>Costliest Unshipped</h2><ol><li><span class="date">2026-10-02</span> · <span class="repo">repo-b</span> · <span class="agent">claude</span> · <span class="outcome">never-merged</span> · <span class="cost">$15.00</span></li><li><span class="date">2026-10-03</span> · <span class="repo">repo-c</span> · <span class="agent">gemini</span> · <span class="outcome">never-merged</span> · <span class="cost">unpriced</span></li><li><span class="date">2026-10-04</span> · <span class="repo">repo-a</span> · <span class="agent">codex</span> · <span class="outcome">reverted</span> · <span class="cost">$8.50</span></li><li><span class="date">2026-10-05</span> · <span class="repo">repo-b</span> · <span class="agent">claude</span> · <span class="outcome">never-merged</span> · <span class="cost">$5.00</span></li><li><span class="date">2026-10-06</span> · <span class="repo">repo-a</span> · <span class="agent">codex</span> · <span class="outcome">reverted</span> · <span class="cost">$3.20</span></li></ol></section></main></body>
</html>
"
`;
