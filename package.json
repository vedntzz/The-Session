{
  "name": "@vedantzz/session",
  "version": "0.3.0",
  "description": "A black box recorder for AI coding sessions: declare intent before the agent runs, record what actually changed and what it cost.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "coding-agent",
    "cli",
    "tokens",
    "productivity"
  ],
  "license": "MIT",
  "author": "vedantzz",
  "type": "module",
  "bin": {
    "session": "dist/cli.js"
  },
  "main": "dist/program.js",
  "types": "dist/program.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "rates.json",
    "PRACTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedntzz/The-Session.git"
  },
  "homepage": "https://github.com/vedntzz/The-Session#readme",
  "bugs": {
    "url": "https://github.com/vedntzz/The-Session/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
